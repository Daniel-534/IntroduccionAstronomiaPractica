  0.8404983195904681\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Delta altura (deg)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.04042740887438153,\n        \"min\": 0.004088319740290558,\n        \"max\": 0.2940851600475871,\n        \"num_unique_values\": 247,\n        \"samples\": [\n          0.0047883759758065025,\n          0.014008305326505877\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
